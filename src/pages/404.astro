---
import StoreLayout from '../layouts/StoreLayout.astro';
import Button from '../components/ui/Button.astro';
---

<StoreLayout
  title="Página no encontrada"
  description="La página que buscas no existe o fue movida."
>
  <div class="mx-auto flex max-w-xl flex-col items-center px-4 py-24 text-center sm:px-6">
    <p class="font-display text-6xl font-bold text-brand">404</p>
    <h1 class="mt-4 font-display text-2xl font-bold text-ink">
      Esta página se escapó con el michi
    </h1>
    <p class="mt-3 text-base leading-relaxed text-ink-muted">
      La dirección no existe o el producto fue movido. Vuelve al catálogo para
      seguir explorando.
    </p>
    <div class="mt-8">
      <Button href="/productos" size="lg">Ver productos</Button>
    </div>
  </div>
</StoreLayout>
