---
import StoreLayout from '../layouts/StoreLayout.astro';
import ProductGrid from '../components/product/ProductGrid.astro';
import { products } from '../data/products';

const allProducts = products;
---

<StoreLayout
  title="Productos"
  description="Catálogo completo de Duy Treats: Churu Cat, Churu Dog, MEGA Churu, arena aglutinante y toallitas húmedas."
>
  <div class="mx-auto max-w-6xl px-4 py-12 sm:px-6 lg:px-8">
    <header class="max-w-2xl">
      <p class="text-sm font-semibold uppercase tracking-wide text-brand">Catálogo</p>
      <h1 class="mt-1 font-display text-3xl font-bold text-ink sm:text-4xl">Todos los productos</h1>
      <p class="mt-3 text-base leading-relaxed text-ink-muted">
        {allProducts.length} productos disponibles. Precios de demostración: se confirmarán con la tienda.
      </p>
    </header>

    <ProductGrid products={allProducts} />
  </div>
</StoreLayout>
