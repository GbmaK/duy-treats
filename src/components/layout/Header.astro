---

import CartButton from '../../islands/CartButton';

const navLinks = [
  { label: 'Productos', href: '/productos' },
  { label: 'Categorías', href: '/categorias' },
  { label: 'Ofertas', href: '/#promo' },
  { label: 'Contacto', href: '/#contacto' },
];
---

<header class="sticky top-0 z-40 border-b border-line bg-surface/95 backdrop-blur">
  <div class="mx-auto flex h-16 max-w-6xl items-center gap-4 px-4 sm:px-6 lg:px-8">
    <!-- Marca -->
    <a href="/" class="flex shrink-0 items-center gap-2.5" aria-label="Duy Treats — inicio">
      <svg viewBox="0 0 48 48" class="h-9 w-9" aria-hidden="true">
        <circle cx="24" cy="24" r="24" fill="var(--color-brand)" />
        <text
          x="24"
          y="31"
          text-anchor="middle"
          font-family="Poppins, ui-sans-serif, system-ui, sans-serif"
          font-weight="700"
          font-size="19"
          fill="#ffffff">DT</text
        >
      </svg>
      <span class="font-display text-lg font-bold tracking-tight text-ink">Duy Treats</span>
    </a>

    <!-- Navegación desktop -->
    <nav class="ml-4 hidden items-center gap-1 md:flex" aria-label="Navegación principal">
      {
        navLinks.map((link) => (
          <a
            href={link.href}
            class="rounded-pill px-3 py-2 text-sm font-semibold text-ink-muted transition-colors hover:bg-surface-muted hover:text-ink"
          >
            {link.label}
          </a>
        ))
      }
    </nav>

    <div class="ml-auto flex items-center gap-1">
      <!--
        Búsqueda: pendiente de funcionalidad. Se mantiene visible con estado
        aria-disabled para no romper el acceso por teclado.
        TODO: habilitar al construir la página /productos con filtros.
      -->
      <button
        type="button"
        aria-disabled="true"
        title="Búsqueda disponible próximamente"
        class="hidden h-10 w-10 items-center justify-center rounded-pill text-ink-muted transition-colors hover:bg-surface-muted hover:text-ink disabled:cursor-not-allowed aria-disabled:opacity-50 sm:flex"
      >
        <svg viewBox="0 0 24 24" class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <circle cx="11" cy="11" r="7" />
          <path d="m20 20-3.5-3.5" stroke-linecap="round" />
        </svg>
        <span class="sr-only">Buscar (próximamente)</span>
      </button>

      <!-- Carrito: isla React (estado compartido con el drawer) -->
      <CartButton client:load />

      <!-- Menú mobile -->
      <button
        id="menu-btn"
        type="button"
        aria-expanded="false"
        aria-controls="mobile-menu"
        class="flex h-10 w-10 items-center justify-center rounded-pill text-ink transition-colors hover:bg-surface-muted md:hidden"
      >
        <svg viewBox="0 0 24 24" class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path d="M4 7h16M4 12h16M4 17h16" stroke-linecap="round" />
        </svg>
        <span class="sr-only">Abrir menú</span>
      </button>
    </div>
  </div>

  <!-- Panel de navegación mobile -->
  <nav id="mobile-menu" class="hidden border-t border-line bg-surface md:hidden" aria-label="Navegación mobile">
    <div class="mx-auto max-w-6xl px-4 py-3 sm:px-6">
      {
        navLinks.map((link) => (
          <a
            href={link.href}
            class="block rounded-xl px-3 py-3 text-base font-semibold text-ink transition-colors hover:bg-surface-muted"
          >
            {link.label}
          </a>
        ))
      }
    </div>
  </nav>
</header>

<script>
  const menuButton = document.getElementById('menu-btn');
  const mobileMenu = document.getElementById('mobile-menu');

  if (menuButton && mobileMenu) {
    menuButton.addEventListener('click', () => {
      const isOpen = !mobileMenu.classList.toggle('hidden');
      menuButton.setAttribute('aria-expanded', String(isOpen));
    });
  }
</script>
