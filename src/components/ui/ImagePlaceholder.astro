---

import type { AccentColor } from '../../types/catalog';
import { ACCENT_BAR, ACCENT_BLOB } from '../../lib/accents';

interface Props {
  /** Texto mostrado en el tile (nombre de producto o categoría). */
  label?: string;
  accent?: AccentColor;
  /** Clases de proporción, ej. "aspect-[4/5]". */
  ratio?: string;
  class?: string;
}

const {
  label,
  accent = 'cyan',
  ratio = 'aspect-[4/5]',
  class: className,
} = Astro.props;

const classes = [
  'relative overflow-hidden rounded-xl bg-surface',
  ratio,
  className,
]
  .filter(Boolean)
  .join(' ');

const ariaLabel = label
  ? `Foto de ${label} (pendiente de reemplazar)`
  : 'Imagen pendiente de reemplazar';
---

<div class={classes} role="img" aria-label={ariaLabel}>
  <!-- Fondo con el patrón de gatos de la marca -->
  <div class="absolute inset-0" aria-hidden="true">
    <svg class="h-full w-full text-ink/10" aria-hidden="true" focusable="false">
      <defs>
        <pattern
          id="cat-fill"
          width="72"
          height="72"
          patternUnits="userSpaceOnUse"
        >
          <g fill="currentColor">
            <g transform="translate(18, 20)">
              <polygon points="-7,10 -5,2 -1,7" />
              <polygon points="7,10 5,2 1,7" />
              <circle cx="0" cy="16" r="9" />
              <circle cx="-3.2" cy="14.5" r="1.3" fill="#ffffff" />
              <circle cx="3.2" cy="14.5" r="1.3" fill="#ffffff" />
            </g>
            <g transform="translate(54, 56) rotate(15)">
              <polygon points="-7,10 -5,2 -1,7" />
              <polygon points="7,10 5,2 1,7" />
              <circle cx="0" cy="16" r="9" />
              <circle cx="-3.2" cy="14.5" r="1.3" fill="#ffffff" />
              <circle cx="3.2" cy="14.5" r="1.3" fill="#ffffff" />
            </g>
          </g>
        </pattern>
      </defs>
      <rect width="100%" height="100%" fill="url(#cat-fill)" />
    </svg>
  </div>

  <!-- Mancha de color de acento -->
  <span
    class:list={['absolute -right-8 -top-8 h-32 w-32 rounded-full blur-2xl', ACCENT_BLOB[accent]]}
    aria-hidden="true"
  ></span>

  <!-- Franja superior de color, como los tiles de Instagram -->
  <span class:list={['absolute inset-x-0 top-0 h-1.5', ACCENT_BAR[accent]]} aria-hidden="true"></span>

  {
    label && (
      <span class="absolute inset-0 flex items-center justify-center p-5">
        <span class="text-center font-display text-sm font-semibold leading-snug text-ink-muted">
          {label}
        </span>
      </span>
    )
  }
</div>
