---

interface Props {
  /** Identificador único: evita colisiones de id si se usa más de una vez. */
  id: string;
  class?: string;
}

const { id, class: className } = Astro.props;
---

<svg
  class:list={['h-full w-full', className]}
  aria-hidden="true"
  focusable="false"
  preserveAspectRatio="xMidYMid slice"
>
  <defs>
    <pattern id={id} width="72" height="72" patternUnits="userSpaceOnUse">
      <g fill="currentColor">
        <g transform="translate(18, 20)">
          <polygon points="-7,10 -5,2 -1,7" />
          <polygon points="7,10 5,2 1,7" />
          <circle cx="0" cy="16" r="9" />
          <circle cx="-3.2" cy="14.5" r="1.3" fill="var(--pattern-eye, #ffffff)" />
          <circle cx="3.2" cy="14.5" r="1.3" fill="var(--pattern-eye, #ffffff)" />
        </g>
        <g transform="translate(54, 56) rotate(15)">
          <polygon points="-7,10 -5,2 -1,7" />
          <polygon points="7,10 5,2 1,7" />
          <circle cx="0" cy="16" r="9" />
          <circle cx="-3.2" cy="14.5" r="1.3" fill="var(--pattern-eye, #ffffff)" />
          <circle cx="3.2" cy="14.5" r="1.3" fill="var(--pattern-eye, #ffffff)" />
        </g>
      </g>
    </pattern>
  </defs>
  <rect width="100%" height="100%" fill={`url(#${id})`} />
</svg>
