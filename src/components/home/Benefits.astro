---
import CatPattern from '../ui/CatPattern.astro';
import SectionHeading from '../ui/SectionHeading.astro';
---

<!--
  Beneficios: sólo afirmaciones verificables. El ítem de reparto mantiene el
  aviso "por confirmar" hasta que la tienda valide zonas y costos.
  Diseño diferenciado a propósito: tres tratamientos distintos (magenta+
  patrón / borde punteado / gris con textura) para evitar el look plantilla.
-->
<section class="mx-auto max-w-6xl px-4 py-16 sm:px-6 lg:px-8">
  <SectionHeading eyebrow="Tienda local" title="Por qué comprar en Duy Treats" />

  <div class="mt-8 grid gap-4 md:grid-cols-3">
    <!-- 01 · Tarjeta de marca: magenta + patrón de gatos -->
    <article
      class="group relative overflow-hidden rounded-card bg-brand p-6 text-white shadow-card transition-all hover:-translate-y-0.5 hover:shadow-pop"
    >
      <div class="pointer-events-none absolute inset-0 text-white/15" aria-hidden="true">
        <div class="parallax-layer absolute -inset-y-20 inset-x-0" data-parallax="0.05">
          <CatPattern id="benefits-cats" />
        </div>
      </div>

      <div class="relative">
        <span
          class="inline-flex h-12 w-12 -rotate-6 items-center justify-center rounded-pill bg-white text-brand transition-transform duration-200 group-hover:rotate-0"
          aria-hidden="true"
        >
          <svg viewBox="0 0 24 24" class="h-6 w-6" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M12 20s-7-4.3-9.2-8.5C1.2 8.3 3.2 5.5 6.3 5.5c1.8 0 3.5 1 4.7 2.5 1.2-1.5 2.9-2.5 4.7-2.5 3.1 0 5.1 2.8 3.5 6C19 15.7 12 20 12 20Z" stroke-linejoin="round" />
          </svg>
        </span>
      </div>

      <h3 class="relative mt-5 font-display text-lg font-bold">Atención cercana</h3>
      <p class="relative mt-2 text-sm leading-relaxed text-white/90">
        Somos tienda local en Puerto Montt: te ayudamos a elegir lo mejor para tu mascota.
      </p>
      <span class="relative mt-5 inline-block rounded-pill bg-white/15 px-3 py-1 text-xs font-semibold">
        Puerto Montt · Región de Los Lagos
      </span>
    </article>

    <!-- 02 · Tarjeta punteada: lo "coordinado" se lee como pendiente de confirmar -->
    <article
      class="group flex flex-col rounded-card border-2 border-dashed border-line bg-surface p-6 shadow-card transition-all hover:-translate-y-0.5 hover:border-brand/40 hover:shadow-pop"
    >
      <div>
        <span
          class="inline-flex h-12 w-12 rotate-3 items-center justify-center rounded-pill border border-accent-purple/20 bg-accent-purple-soft text-accent-purple-ink transition-transform duration-200 group-hover:rotate-0"
          aria-hidden="true"
        >
          <svg viewBox="0 0 24 24" class="h-6 w-6" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M12 21s-6.5-5.6-8.3-9.4C2.2 8.7 4 5.5 7.2 5.5c1.9 0 3.6 1 4.8 2.6 1.2-1.6 2.9-2.6 4.8-2.6 3.2 0 5 3.2 3.5 6.1C18.5 15.4 12 21 12 21Z" stroke-linejoin="round" />
            <path d="M12 3v3" stroke-linecap="round" />
          </svg>
        </span>
      </div>

      <h3 class="mt-5 font-display text-lg font-bold text-ink">Retiro o reparto coordinado</h3>
      <p class="mt-2 text-sm leading-relaxed text-ink-muted">
        Retiro en Puerto Montt y reparto coordinado, con la atención de siempre.
      </p>
      <span class="mt-auto inline-block w-fit rounded-pill border border-dashed border-line px-3 py-1 pt-5 text-xs font-semibold text-ink-muted">
        Zonas y costos por confirmar
      </span>
    </article>

    <!-- 03 · Tarjeta con textura: el guiño felino -->
    <article
      class="group relative overflow-hidden rounded-card bg-surface-muted p-6 shadow-card transition-all hover:-translate-y-0.5 hover:shadow-pop"
    >
      <div class="pointer-events-none absolute inset-0 text-ink/5" aria-hidden="true">
        <CatPattern id="benefits-cats-2" />
      </div>

      <div class="relative">
        <span
          class="inline-flex h-12 w-12 -rotate-3 items-center justify-center rounded-pill border border-accent-yellow/30 bg-accent-yellow-soft text-accent-yellow-ink transition-transform duration-200 group-hover:rotate-0"
          aria-hidden="true"
        >
          <!-- Carita de gato -->
          <svg viewBox="0 0 24 24" class="h-6 w-6" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round">
            <path d="M5 10 6 4.5 10 7.5" />
            <path d="M19 10 18 4.5 14 7.5" />
            <path d="M4.5 12.5c0-3.6 3.4-6 7.5-6s7.5 2.4 7.5 6-3.4 6.5-7.5 6.5-7.5-2.9-7.5-6.5Z" />
            <path d="M9.5 12h.01M14.5 12h.01" stroke-linecap="round" stroke-width="2.5" />
            <path d="M10.5 15.5c1 .7 2 .7 3 0" stroke-linecap="round" />
          </svg>
        </span>
      </div>

      <h3 class="relative mt-5 font-display text-lg font-bold text-ink">Gatos primero</h3>
      <p class="relative mt-2 text-sm leading-relaxed text-ink-muted">
        Catálogo pensado para michis, con espacio también para perros y otras mascotas.
      </p>
      <div class="relative mt-auto flex flex-wrap gap-1.5 pt-5">
        <span class="rounded-pill bg-accent-yellow-soft px-2.5 py-1 text-xs font-semibold text-accent-yellow-ink">Gatos</span>
        <span class="rounded-pill bg-accent-green-soft px-2.5 py-1 text-xs font-semibold text-accent-green-ink">Perros</span>
        <span class="rounded-pill bg-accent-cyan-soft px-2.5 py-1 text-xs font-semibold text-accent-cyan-ink">Otras mascotas</span>
      </div>
    </article>
  </div>
</section>
