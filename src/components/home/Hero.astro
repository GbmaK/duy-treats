---
import Button from '../ui/Button.astro';
import ImagePlaceholder from '../ui/ImagePlaceholder.astro';
import CatPattern from '../ui/CatPattern.astro';
import { formatPrice } from '../../lib/format';
import { products } from '../../data/products';

const featured = products.find((product) => product.slug === 'churu-cat-atun-pollo');
---

<section class="relative overflow-hidden">
  <!-- Capa lejana: mancha magenta (casi quieta, da atmósfera) -->
  <div class="pointer-events-none absolute inset-0 -z-10" aria-hidden="true">
    <div class="parallax-layer absolute -inset-y-32 inset-x-0" data-parallax="0.04">
      <span class="absolute left-1/4 top-1/3 h-72 w-72 rounded-full bg-brand/10 blur-3xl"></span>
      <span class="absolute right-1/5 bottom-1/4 h-56 w-56 rounded-full bg-accent-yellow/15 blur-3xl"></span>
    </div>
  </div>

  <!-- Capa media: patrón de gatos de la marca -->
  <div class="pointer-events-none absolute inset-0 -z-10" aria-hidden="true">
    <div class="parallax-layer absolute -inset-y-32 inset-x-0" data-parallax="0.1">
      <CatPattern id="hero-cats" class="text-brand/10" />
    </div>
  </div>

  <div class="mx-auto grid max-w-6xl items-center gap-12 px-4 py-16 md:grid-cols-2 md:py-24 sm:px-6 lg:px-8">
    <!-- Copy -->
    <div>
      <p class="inline-flex items-center rounded-pill bg-brand-soft px-3 py-1 text-xs font-semibold uppercase tracking-wide text-brand-ink">
        Puerto Montt · Para gatos exigentes
      </p>
      <h1 class="mt-5 font-display text-display font-bold text-ink">
        Todo para consentir a tu michi
      </h1>
      <p class="mt-5 max-w-md text-lg leading-relaxed text-ink-muted">
        Churu, arena aglutinante y toallitas: los favoritos de tu gato, en un solo lugar.
      </p>
      <div class="mt-8 flex flex-wrap gap-3">
        <Button href="/productos" size="lg">Ver productos</Button>
        <Button href="#categorias" variant="secondary" size="lg">Explorar categorías</Button>
      </div>
    </div>

    <!-- Composición visual: tile de producto + tarjeta flotante -->
    <div class="relative mx-auto w-full max-w-sm">
      <div class="parallax-layer" data-parallax="0.06">
        <ImagePlaceholder
          label={featured?.name ?? 'Churu Cat'}
          accent="yellow"
          ratio="aspect-[4/5]"
          class="rounded-2xl border border-line shadow-card"
        />
      </div>

      <div
        class="parallax-layer absolute -bottom-6 -left-4 flex w-44 items-center gap-3 rounded-xl border border-line bg-surface p-3 shadow-pop sm:-left-8"
        data-parallax="0.18"
        aria-hidden="true"
      >
        <ImagePlaceholder accent="yellow" ratio="aspect-square h-12 w-12" />
        <div class="min-w-0">
          <p class="truncate text-xs font-semibold text-ink">Churu Cat</p>
          <p class="font-display text-sm font-bold text-brand">
            {formatPrice(featured?.price ?? 4290)}
          </p>
        </div>
      </div>
    </div>
  </div>
</section>
