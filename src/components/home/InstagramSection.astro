---
import Button from '../ui/Button.astro';
import CatPattern from '../ui/CatPattern.astro';
---

<section class="mx-auto max-w-6xl px-4 pb-16 sm:px-6 lg:px-8">
  <div class="relative overflow-hidden rounded-2xl border border-line bg-surface-muted px-6 py-14 text-center">
    <div class="pointer-events-none absolute inset-0 text-ink/5" aria-hidden="true">
      <div class="parallax-layer absolute -inset-y-16 inset-x-0" data-parallax="0.06">
        <CatPattern id="community-cats" />
      </div>
    </div>

    <div class="relative">
      <h2 class="font-display text-2xl font-bold text-ink sm:text-3xl">
        Síguenos en Instagram
      </h2>
      <p class="mx-auto mt-3 max-w-md text-base leading-relaxed text-ink-muted">
        Nuevos productos, variedades y ofertas primero en <strong class="font-semibold text-ink">@duytreats</strong>.
      </p>
      <div class="mt-8 flex justify-center">
        <Button
          href="https://www.instagram.com/duytreats/"
          variant="secondary"
          size="lg"
        >
          <svg viewBox="0 0 24 24" class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <rect x="3" y="3" width="18" height="18" rx="5" />
            <circle cx="12" cy="12" r="4" />
            <circle cx="17.2" cy="6.8" r="1.2" fill="currentColor" stroke="none" />
          </svg>
          @duytreats
        </Button>
      </div>
    </div>
  </div>
</section>
