---
import Button from '../ui/Button.astro';
import CatPattern from '../ui/CatPattern.astro';
---

<!--
  Bloque promocional de EJEMPLO. El copy y los colores son placeholders:
  reemplazar por una promoción real cuando la tienda la confirme.
  Doble capa parallax: patrón lejano (0.08) + manchas cercanas (0.12).
-->
<section id="promo" class="scroll-mt-20 bg-brand py-16">
  <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
    <div class="relative overflow-hidden rounded-2xl">
      <!-- Capa lejana: patrón de gatos -->
      <div class="pointer-events-none absolute inset-0 text-white/15" aria-hidden="true">
        <div class="parallax-layer absolute -inset-y-32 inset-x-0" data-parallax="0.08">
          <CatPattern id="promo-cats-far" />
        </div>
      </div>

      <!-- Capa cercana: manchas de color -->
      <div class="pointer-events-none absolute inset-0" aria-hidden="true">
        <div class="parallax-layer absolute -inset-y-32 inset-x-0" data-parallax="0.12">
          <span class="absolute left-[12%] top-[18%] h-40 w-40 rounded-full bg-white/15 blur-3xl"></span>
          <span class="absolute right-[18%] bottom-[12%] h-56 w-56 rounded-full bg-accent-yellow/25 blur-3xl"></span>
          <span class="absolute left-1/2 top-1/2 h-24 w-24 -translate-x-1/2 -translate-y-1/2 rounded-full bg-white/10 blur-2xl"></span>
        </div>
      </div>

      <div class="relative px-6 py-14 text-center sm:px-12">
        <span class="inline-block rounded-pill bg-white/15 px-3 py-1 text-xs font-semibold uppercase tracking-wide text-white">
          Bloque promocional de ejemplo
        </span>
        <h2 class="mt-4 font-display text-3xl font-bold text-white sm:text-4xl">Hora del Churu</h2>
        <p class="mx-auto mt-3 max-w-md text-base leading-relaxed text-white/90">
          Snacks cremosos para los momentos favoritos del día de tu michi.
        </p>
        <div class="mt-8 flex justify-center">
          <Button
            href="/categorias/churu-cat"
            variant="secondary"
            size="lg"
            class="border-white/40 bg-white text-brand hover:bg-white/90"
          >
            Ver Churu Cat
          </Button>
        </div>
      </div>
    </div>
  </div>
</section>
